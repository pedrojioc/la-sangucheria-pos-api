import { Unit, UnitPrimitives } from '@/modules/units/domain/unit'
import { UnitTypeEnum } from '@/modules/units/domain/unit-type'
import { UuidMother } from '@test/shared/__mothers__/UuidMother'
import { UnitNameMother } from './UnitNameMother'
import { UnitSymbolMother } from './UnitSymbolMother'
import { UnitTypeMother } from './UnitTypeMother'

export class UnitMother {
  static create(params: Partial<UnitPrimitives> = {}): Unit {
    const primitives: UnitPrimitives = {
      id: params.id ?? UuidMother.random(),
      name: params.name ?? UnitNameMother.random().value,
      symbol: params.symbol ?? UnitSymbolMother.random().value,
      type: params.type ?? UnitTypeMother.random().value,
      isActive: params.isActive ?? true
    }

    return Unit.fromPrimitives(primitives)
  }

  static random(): Unit {
    return this.create()
  }

  static kilogram(params: Partial<UnitPrimitives> = {}): Unit {
    return this.create({
      ...params,
      name: 'Kilogram',
      symbol: 'kg',
      type: UnitTypeEnum.WEIGHT
    })
  }

  static liter(params: Partial<UnitPrimitives> = {}): Unit {
    return this.create({
      ...params,
      name: 'Liter',
      symbol: 'l',
      type: UnitTypeEnum.VOLUME
    })
  }

  static meter(params: Partial<UnitPrimitives> = {}): Unit {
    return this.create({
      ...params,
      name: 'Meter',
      symbol: 'm',
      type: UnitTypeEnum.LENGTH
    })
  }

  static unit(params: Partial<UnitPrimitives> = {}): Unit {
    return this.create({
      ...params,
      name: 'Unit',
      symbol: 'unit',
      type: UnitTypeEnum.UNIT
    })
  }
}
