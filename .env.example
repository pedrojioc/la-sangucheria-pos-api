# Application
NODE_ENV=development
PORT=3000
APP_NAME=La Sanguchería POS

# Database
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=pedro
DB_PASSWORD=pedro
DB_DATABASE=la_sangucheria_pos
DB_SCHEMA=public
DB_SYNCHRONIZE=false
DB_LOGGING=true
DB_SSL=false

# TypeORM
TYPEORM_MIGRATIONS_RUN=false
TYPEORM_MIGRATIONS_DIR=src/shared/infrastructure/database/typeorm/migrations

# API
API_PREFIX=api
API_VERSION=v1

# Cors
CORS_ENABLED=true
CORS_ORIGIN=http://localhost:3001

# JWT Authentication (RS256 with asymmetric encryption)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRATION=7d
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nYOUR_PUBLIC_KEY_HERE\n-----END PUBLIC KEY-----"
JWT_ISSUER=lasangucheria-pos
JWT_AUDIENCE=lasangucheria-pos-api
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Logging
LOG_LEVEL=debug

# Cloudflare Images (Production)
CLOUDFLARE_ACCOUNT_ID=your-account-id-here
CLOUDFLARE_IMAGES_API_TOKEN=your-api-token-here
CLOUDFLARE_IMAGES_ACCOUNT_HASH=your-account-hash-here

# Local File Storage (Development)
LOCAL_UPLOADS_DIR=uploads
LOCAL_UPLOADS_URL=http://localhost:3000

# How to get Cloudflare credentials:
# 1. Account ID: Dashboard → Account → Account ID
# 2. API Token: Dashboard → My Profile → API Tokens → Create Token
#    - Template: "Images Write"
#    - Permissions: Account > Cloudflare Images > Edit
# 3. Account Hash: Dashboard → Images → Overview (visible in delivery URL)
#    - Example URL: https://imagedelivery.net/{ACCOUNT_HASH}/...